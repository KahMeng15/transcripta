# Transcription & Summarization Configuration

# Directories (relative to project root or absolute)
INPUT_DIR="./input_media"
OUTPUT_DIR="./output_files"
PROMPTS_DIR="./prompts"

# File patterns (comma separated: e.g., *.mp4,*.mp3,*.wav)
FILE_PATTERN="*.mp4,*.mp3,*.wav"

# API Keys
HUGGINGFACE_TOKEN="your_huggingface_token_here"

# OpenAI API Key for summarization (gpt-4o-mini)
OPENAI_API_KEY="your_openai_api_key_here"

# Google Gemini API Key for summarization
GEMINI_API_KEY="your_gemini_api_key_here"

# Summarization Provider (openai, gemini)
SUMMARIZER_PROVIDER="openai"

# Model Selection
# Recommended for Apple Silicon (MLX Community)
WHISPER_MODEL_PATH="mlx-community/whisper-large-v3-turbo"

# Speaker Diarization Model
DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"
