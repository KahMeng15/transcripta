# Transcription & Summarization Configuration

# Directories (relative to project root or absolute)
INPUT_DIR="./input_media"
OUTPUT_DIR="./output_files"
PROMPTS_DIR="./prompts"

# Timeout before application auto-quits while idle waiting for user input (in seconds)
IDLE_TIMEOUT=300

# File patterns (comma separated: e.g., *.mp4,*.mp3,*.wav)
FILE_PATTERN="*.mp4,*.mp3,*.wav"

# API Keys
HUGGINGFACE_TOKEN="your_huggingface_token_here"

# OpenAI API Key for summarization (gpt-4o-mini)
OPENAI_API_KEY="your_openai_api_key_here"

# Google Gemini API Key for summarization
GEMINI_API_KEY="your_gemini_api_key_here"

# Models to use for Gemini (comma separated, first one is primary, rest are fallbacks)
GEMINI_MODELS="gemini-3-flash-preview, gemma-4-31b-it"

# Models to use for OpenAI (comma separated)
OPENAI_MODELS="gpt-4o-mini"

# Summarization Provider (openai, gemini)
SUMMARIZER_PROVIDER="openai"

# Model Selection
# Recommended for Apple Silicon (MLX Community)
WHISPER_MODEL_PATH="mlx-community/whisper-large-v3-turbo"

# Optional: Force a specific language (e.g., "ms" for Malay, "en" for English, or "auto")
# Leaving it blank or "auto" will enable automatic language detection.
WHISPER_LANGUAGE="auto"

# Optional: Provide an initial prompt to improve accuracy or nudge multilingual detection.
# e.g., "Ini perbualan dalam Bahasa Melayu and English." for mixed audio.
WHISPER_PROMPT=""

# Speaker Diarization Model
DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"
